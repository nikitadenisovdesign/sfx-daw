# Copy to .env and edit for your machine.
#   (windows: copy .env.example .env)

# Where generated WAV files go
SFX_OUTPUT_DIR=C:/sfx-daw/generated

# SQLite metadata DB
SFX_DB_PATH=C:/sfx-daw/sfx_cache.db

# Folder containing model subfolders (stable-audio-open/ and tangoflux/).
# Use absolute path to avoid surprises with cwd.
SFX_MODELS_DIR=Z:/Claude/SFXDAW/models

# Default backend to use when /generate doesn't specify one.
# Options: "stable-audio-open" | "tangoflux"
SFX_DEFAULT_BACKEND=stable-audio-open

# Backends to autoload at startup. Empty = only the default. "*" = all.
# Loading both eats ~10GB VRAM. RTX 5090 (32GB) handles it easily.
# Examples:
#   SFX_AUTOLOAD_BACKENDS=                           (only default)
#   SFX_AUTOLOAD_BACKENDS=stable-audio-open,tangoflux
#   SFX_AUTOLOAD_BACKENDS=*
SFX_AUTOLOAD_BACKENDS=

# Server
SFX_HOST=0.0.0.0
SFX_PORT=8000

# Default inference parameters
SFX_DEFAULT_STEPS=100
SFX_DEFAULT_GUIDANCE=7.0
SFX_DEFAULT_SAMPLER=dpmpp-3m-sde

# CORS: "*" for development; list of origins for production
SFX_CORS_ORIGINS=*
